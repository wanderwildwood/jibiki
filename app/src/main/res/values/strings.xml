    <!-- When the selection came from a field that can be written in -->
    <!-- %1$s is the word picked, %2$s the word it would replace -->
    <string name="replace_use">Put “%1$s” in place of “%2$s”</string>
    <!-- %1$s is a word -->
    <string name="replace_look_up">Look up “%1$s”</string>


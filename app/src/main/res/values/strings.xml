    <string name="pos_r">adverb</string>
    <!-- Before a list of words that mean the same -->
    <string name="same">Also</string>
    <!-- Before a list of words that mean the opposite -->
    <string name="opposite">Opposite</string>
    <!-- Before adjectives close in meaning -->
    <string name="near">Near</string>
    <!-- Before the broader word a noun or verb is a kind of: "A kind of: tree" -->

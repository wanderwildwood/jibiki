    <!-- About -->

    <string name="about_title">Dictionary %1$s</string>
    <string name="about_what">Select a word in another app and choose Define. Nothing leaves the phone: the whole word list is inside the app.</string>
    <string name="about_privacy_title">Privacy</string>
    <string name="about_privacy">Everything stays on this phone. The app has no internet access, so nothing is sent anywhere, and nothing is collected about you. When you choose Define in another app, it receives only the text you selected. It keeps the last 30 words you looked up, on this phone only; Clear this list removes them. There are no ads, no analytics and no tracking. Pressing the donation or website line opens your browser.</string>
    <string name="about_terms_title">Terms</string>
    <string name="about_terms">This app is free software under the GNU General Public License v3. It comes with no warranty: use it at your own risk.</string>
